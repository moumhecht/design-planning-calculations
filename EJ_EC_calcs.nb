Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"EC", " ", "is", " ", "defined", " ", "from", " ", "the", " ", 
      RowBox[{"ratio", ":", "ratio"}]}], "=", 
     RowBox[{"EJ", "/", "EC"}]}], ",", 
    RowBox[{
     RowBox[{"so", " ", "EC"}], "=", 
     RowBox[{"EJ", "/", "ratio"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EC", "[", 
    RowBox[{"EJ_", ",", "ratio_"}], "]"}], ":=", 
   RowBox[{"EJ", "/", "ratio"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Transmon", " ", "frequency", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"in", " ", "GHz"}], ",", 
      RowBox[{
      "assuming", " ", "EJ", " ", "and", " ", "EC", " ", "in", " ", "GHz"}]}],
      ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omega", "[", 
    RowBox[{"EJ_", ",", "ratio_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"8", "*", 
      RowBox[{"EC", "[", 
       RowBox[{"EJ", ",", "ratio"}], "]"}], "*", "EJ"}], "]"}], "-", 
    RowBox[{"EC", "[", 
     RowBox[{"EJ", ",", "ratio"}], "]"}]}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Inputs", "--"}]}]}], "-"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"targetFreq", "=", " ", "4.5"}], ";"}], "    ", 
  RowBox[{"(*", "GHz", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targetRatio", "=", "70"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"EJ", "/", "EC"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Solve"}]}], " ", "for", " ", 
     RowBox[{"EJ", "--"}]}], "-"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"omega", "[", 
         RowBox[{"EJ", ",", "targetRatio"}], "]"}], "==", "targetFreq"}], ",", 
       RowBox[{"EJ", ">", "0"}]}], "}"}], ",", "EJ"}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Extract"}]}], " ", "and", " ", "compute", " ", 
     RowBox[{"EC", "--"}]}], "-"}], "*)"}]}], "\n", 
 RowBox[{"EJsol", "=", 
  RowBox[{"EJ", "/.", " ", 
   RowBox[{"First", "[", "sol", "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"ECsol", "=", 
   RowBox[{"EC", "[", 
    RowBox[{"EJsol", ",", "targetRatio"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Target EJ = \>\"", ",", "EJsol", ",", "\"\< GHz\>\""}], 
  "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Target EC = \>\"", ",", "ECsol", ",", "\"\< GHz\>\""}], 
  "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Verification - omega = \>\"", ",", 
   RowBox[{"omega", "[", 
    RowBox[{"EJsol", ",", "targetRatio"}], "]"}], ",", "\"\< GHz\>\""}], 
  "]"}]}], "Input",

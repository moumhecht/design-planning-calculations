   "\[IndentingNewLine]", 
   RowBox[{"(*", "Extract", "*)"}], "\n", 
   RowBox[{
    RowBox[{"CJsol", "=", 
     RowBox[{"CJ", "/.", " ", "sol"}]}], ";"}], "\n", 
   RowBox[{

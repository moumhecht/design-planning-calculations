Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Inputs", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fGHz", "=", "9.5"}], ";"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"resonator", " ", "frequency"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kappaKHz", "=", 
    RowBox[{"10", "*", 
     RowBox[{"10", "^", "3"}]}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"desired", " ", "linewidth"}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Z0", "=", "50"}], ";"}], "           ", 
  RowBox[{"(*", 
   RowBox[{"feedline", " ", "impedance"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", " ", "=", " ", "2"}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Unit", " ", "conversions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fr", "=", 
   RowBox[{"fGHz", "*", 
    RowBox[{"10", "^", "9"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]r", "=", 
   RowBox[{"2", "*", "Pi", "*", "fr"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"2", "*", "Pi", "*", "kappaKHz", "*", 
     RowBox[{"10", "^", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Required", " ", "coupling", " ", "capacitance"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cc", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "*", "\[Kappa]"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"m", "*", 
        RowBox[{"\[Omega]r", "^", "3"}], "*", 
        RowBox[{"Z0", "^", "2"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Required coupling capacitance = \>\"", ",", 
    RowBox[{"Cc", "*", 
     RowBox[{"10", "^", "15"}]}], ",", "\"\< fF\>\""}], "]"}], 
  ";"}]}], "Input",

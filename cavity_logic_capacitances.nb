Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Physical", " ", "constants"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"e", "=", "1.602176634*^-19"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", "6.626*^-34"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbar", "=", "1.05457*^-34"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Capacitance", " ", "matrix", " ", "energies"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ECQ", "[", 
   RowBox[{"CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"e", "^", "2"}], "/", "2"}], ")"}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"CR", "+", "Cg"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"CQ", "*", "CR"}], "+", 
      RowBox[{"CR", "*", "Cg"}], "+", 
      RowBox[{"CQ", "*", "Cg"}]}], ")"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ECR", "[", 
    RowBox[{"CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"e", "^", "2"}], "/", "2"}], ")"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"CQ", "+", "Cg"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"CQ", "*", "CR"}], "+", 
       RowBox[{"CR", "*", "Cg"}], "+", 
       RowBox[{"CQ", "*", "Cg"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Inductive", " ", "energy"}], "\[LongDash]", 
    RowBox[{"explicit", " ", "L"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EL", "[", "L_", "]"}], ":=", 
   RowBox[{
    RowBox[{"hbar", "^", "2"}], "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", 
      RowBox[{"e", "^", "2"}], "*", "L"}], ")"}]}]}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"EJ", " ", "from", " ", "ratio"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ratioQ", "=", "70"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EJQ", "[", 
    RowBox[{"CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{"ratioQ", "*", 
    RowBox[{"ECQ", "[", 
     RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}]}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Frequencies", " ", "and", " ", "coupling"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omegaQ", "[", 
    RowBox[{"CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"8", "*", 
      RowBox[{"EJQ", "[", 
       RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}], "*", 
      RowBox[{"ECQ", "[", 
       RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}], "]"}], "-", 
    RowBox[{"ECQ", "[", 
     RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omegaR", "[", 
    RowBox[{"L_", ",", "CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"8", "*", 
     RowBox[{"EL", "[", "L", "]"}], "*", 
     RowBox[{"ECR", "[", 
      RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etaQ", "[", 
    RowBox[{"CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"ECQ", "[", 
     RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"L_", ",", "CR_", ",", "Cg_", ",", "CQ_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "4"}], "*", 
      RowBox[{"e", "^", "2"}]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{"Cg", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CR", "*", "CQ"}], "+", 
        RowBox[{"CR", "*", "Cg"}], "+", 
        RowBox[{"CQ", "*", "Cg"}]}], ")"}]}], ")"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"EL", "[", "L", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"32", "*", 
          RowBox[{"ECR", "[", 
           RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}], ")"}]}], "*", 
       RowBox[{
        RowBox[{"EJQ", "[", 
         RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"32", "*", 
          RowBox[{"ECQ", "[", 
           RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}], ")"}]}]}], ")"}], 
     "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"etaQ", "[", 
        RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"omegaQ", "[", 
          RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}]}], ")"}]}]}], ")"}]}]}],
   "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Targets", "\[LongDash]", 
    RowBox[{"all", " ", "in", " ", "Joules"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetOmegaQ", "=", 
   RowBox[{"4.5*^9", "*", "h"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"targetOmegaR", "=", 
   RowBox[{"5.75*^9", "*", "h"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targetg", "=", 
    RowBox[{
     RowBox[{"-", "45*^6"}], "*", "h"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"negative", " ", "from", " ", "formula"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targetECQ", "=", 
    RowBox[{"200*^6", "*", "h"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Solve", " ", "for", " ", "CR"}], ",", "Cg", ",", "CQ", ",", 
    "L"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"ECQ", "[", 
         RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}], "==", "targetECQ"}], 
       ",", 
       RowBox[{
        RowBox[{"omegaQ", "[", 
         RowBox[{"CR", ",", "Cg", ",", "CQ"}], "]"}], "==", "targetOmegaQ"}], 
       ",", 
       RowBox[{
        RowBox[{"omegaR", "[", 
         RowBox[{"L", ",", "CR", ",", "Cg", ",", "CQ"}], "]"}], "==", 
        "targetOmegaR"}], ",", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"L", ",", "CR", ",", "Cg", ",", "CQ"}], "]"}], "==", 
        "targetg"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"CQ", ",", "96*^-15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"CR", ",", "500*^-15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Cg", ",", "5*^-15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "2*^-9"}], "}"}]}], "}"}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CQsol", "=", 
   RowBox[{"CQ", "/.", " ", "sol"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CRsol", "=", 
   RowBox[{"CR", "/.", " ", "sol"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Cgsol", "=", 
   RowBox[{"Cg", "/.", " ", "sol"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lsol", "=", 
    RowBox[{"L", "/.", " ", "sol"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
